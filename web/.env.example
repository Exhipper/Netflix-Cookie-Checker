# Example environment variables for self-hosted Windows Server + Supabase
# Copy this file to .env and fill in your real values.

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# Use the "Transaction pooler" or "Session pooler" URL for server environments.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional: force SSL for managed Postgres providers (auto-detected for Supabase/Render)
DATABASE_SSL=true

# Server port (default 8080)
PORT=8080
NODE_ENV=production

# Set to true to disable free-proxy auto-fetch and run checks directly from your server IP.
# Useful when all public proxy lists are unreachable or you want to use your own proxies.
DISABLE_PROXY_FETCH=false
